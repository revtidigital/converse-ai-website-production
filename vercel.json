{
  "routes": [
    {
      "has": [{ "type": "host", "value": "www.theconverseai.com" }],
      "src": "/(.*)",
      "status": 301,
      "headers": { "Location": "https://theconverseai.com/$1" }
    },

    { "handle": "filesystem" },

    {
      "src": "/(.*\\.(ico|png|jpg|jpeg|svg|css|js|woff|woff2))",
      "dest": "/$1"
    },

    {
      "src": "/faq",
      "status": 410
    },
    {
      "src": "/faq_cat/(.*)",
      "status": 410
    },
    {
      "src": "/(.*)/page/(.*)",
      "status": 410
    },
    {
      "src": "/product/(.*)",
      "status": 410
    },
    {
      "src": "/wp-content/(.*)",
      "status": 410
    },
    {
      "src": "/(19|20)[0-9]{2}/(.*)",
      "status": 410
    },

    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": { "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0" }
    }
  ]
}
